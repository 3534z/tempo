{
  "expo": {
    "name": "tempo",
    "slug": "tempo",
    "scheme": "tempo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tempo.local"
    },
    "android": {
      "package": "app.tempo.local"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow tempo to listen to your plans.",
          "speechRecognitionPermission": "Allow tempo to turn your voice into plans."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow tempo to record your voice messages."
        }
      ]
    ]
  }
}
